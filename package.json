    "react-dom": "^19.3.1",
    "sass": "^1.80.6",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3"
  }
}
